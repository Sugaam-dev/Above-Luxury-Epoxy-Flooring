# ==============================================================================
# ABOVE° — Concept Living: AI Transformation Studio Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Serverless Backend)
# ------------------------------------------------------------------------------
# Used by Vercel Serverless Function: api/generate-image.js
# Get your API key from Google AI Studio: https://aistudio.google.com/
# NOTE: Do NOT prefix with VITE_ to keep this private on the serverless backend.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Multimodal image generation model (Default: gemini-2.5-flash-image)
# Supported options: gemini-2.5-flash-image, gemini-3.1-flash-image, gemini-3-pro-image
GEMINI_MODEL=gemini-2.5-flash-image

# ------------------------------------------------------------------------------
# 2. EmailJS Configuration (Client-side Email Delivery)
# ------------------------------------------------------------------------------
# Used by @emailjs/browser in src/services/emailService.js
# Register at: https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
